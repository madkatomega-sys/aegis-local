# Copy to .env and edit. .env is ignored by Git; never commit tokens.

# Hardware profile from config/profiles/ (without .toml).
AEGIS_PROFILE=nvidia-12gb

# Path to the llama-server binary for your GPU backend. Leave empty to search PATH.
#   Windows example: C:\tools\llama.cpp\llama-server.exe
#   Linux example:   /home/you/.local/bin/llama-server
AEGIS_LLAMA_SERVER=

# Model files (GGUF). These override the "model" field in the profile.
AEGIS_TIER0_MODEL=
AEGIS_TIER1_MODEL=

# Address llama-server binds to. Leave empty for the safe default:
#   Windows: 127.0.0.1 (Docker Desktop reaches it through host.docker.internal)
#   Linux:   the container bridge gateway, reachable from host and containers, not the LAN
AEGIS_LLAMA_HOST=

# Container runtime: auto, docker, or podman.
AEGIS_RUNTIME=auto

# Read-only notes vault for the writing auditor. Defaults to ./vault-example.
AEGIS_VAULT_PATH=./vault-example

# GitHub tools through the guard. Use a fine-grained personal access token scoped to the
# repositories you want the agent to see. GitHub content is always treated as untrusted.
AEGIS_GITHUB_ENABLED=false
GITHUB_PAT=

# Tier endpoints inside the container network. aegis.py sets these from the profile; you only
# need them if you run the Compose stack by hand.
AEGIS_TIER0_URL=http://host.docker.internal:8080/v1
AEGIS_TIER1_URL=http://host.docker.internal:8081/v1

# Tokens the guard requires. aegis.py generates these into .aegis/tokens.env on first run.
# Sandboxes never receive them, so code running in a sandbox can't call the guard or approve
# its own actions.
AEGIS_CLIENT_TOKEN=
AEGIS_ADMIN_TOKEN=
