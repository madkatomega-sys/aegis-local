+import re
+
+
+def slugify(text):
+    """Convert text to a URL-safe slug."""
+    # Convert to lowercase
+    text = text.lower()
+    # Replace non-alphanumeric characters with hyphens
+    text = re.sub(r'[^a-z0-9]+', '-', text)
+    # Collapse multiple hyphens into one
+    text = re.sub(r'-+', '-', text)
+    # Strip leading/trailing hyphens
+    text = text.strip('-')
+    return text
