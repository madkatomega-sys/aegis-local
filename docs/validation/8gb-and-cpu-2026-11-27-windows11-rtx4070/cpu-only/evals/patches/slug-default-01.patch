+import re
+
+
+def slugify(text):
+    """Convert text to a URL-friendly slug."""
+    # Lowercase
+    text = text.lower()
+    # Remove non-alphanumeric characters except hyphens, replace with hyphens
+    text = re.sub(r'[^a-z0-9-]', '-', text)
+    # Collapse multiple hyphens into one
+    text = re.sub(r'-+', '-', text)
+    # Strip leading and trailing hyphens
+    text = text.strip('-')
+    return text
+
